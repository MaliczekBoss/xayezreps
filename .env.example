# Skopiuj do .env.local (lokalnie) albo wpisz w ustawieniach hostingu i ustaw własne wartości.
# Opis każdej zmiennej i co jest wymagane: HOSTING.md

# MongoDB (np. hosting Pterodactyl): gdy ustawione, wszystkie dane, sesje i zdjęcia idą do tej bazy – PTERODACTYL.md
# MONGODB_URI=mongodb://użytkownik:hasło@host:27017/?authSource=admin
# MONGODB_DB=xayezreps
# (opcjonalnie) magazyn S3 za CDN zdjęć (NEXT_PUBLIC_IMAGES_URL): nowe zdjęcia QC trafiają od razu do folderu q/.
# Bez tych zmiennych nowe zdjęcia QC zapisują się w MongoDB i strona podaje je pod /q/…
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=nazwa-bucketu
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# Godziny zadań cyklicznych (UTC), gdy strona startuje przez index.js
# CRON_SCHEDULE=qc=04:00,prices=04:30

# Baza Upstash Redis (REST): statystyki, sesje admina, historia QC, ceny od agenta, limity zapytań.
# Na Vercelu ustawia je integracja Upstash (KV_REST_API_URL / KV_REST_API_TOKEN). Bez bazy strona działa
# na pamięci procesu – tylko do testów, po restarcie wszystko znika.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Adres strony (linki w mapie strony, podglądy linków). Na Vercelu brany z domeny produkcyjnej, na własnym serwerze wymagany
# NEXT_PUBLIC_SITE_URL=https://xayezreps.pl
# Tylko gdy zdjęcia (foldery i/, s/, o/) leżą na osobnym serwerze, np. Cloudflare R2 – adres bez „/” na końcu (HOSTING.md)
# NEXT_PUBLIC_IMAGES_URL=https://cdn.xayezreps.pl
# Tylko własny serwer za odwrotnym proxy (nginx, Caddy): nagłówek z adresem klienta, który proxy nadpisuje –
# 1 (= X-Real-IP), x-forwarded-for (ostatni adres) albo cf-connecting-ip. Limity zapytań liczą się wtedy na adres klienta
# TRUST_PROXY=1

# Hasło do panelu admina (statystyki). Zalecane: min. 16 znaków, nigdzie indziej nieużywane
ADMIN_PASSWORD=zmien-mnie
# Losowy sekret do podpisywania sesji, inny niż hasło – zalecane min. 32 znaki
ADMIN_SECRET=wygeneruj-dlugi-losowy-ciag
# (zalecane) logowanie dwuetapowe: klucz z `npm run admin:2fa`; bez niego logowanie pyta tylko o hasło
# ADMIN_TOTP_SECRET=

# Wyszukiwanie po zdjęciu. Pytane po kolei: API zgodne z OpenAI, Gemini, Claude – wystarczy jedno.
# API zgodne z OpenAI (np. codex.sale): adres, klucz i model
# OPENAI_BASE_URL=https://codex.sale/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# (opcjonalnie) „myślenie” modelu: none (domyślnie, najszybciej), low, medium
# OPENAI_REASONING_EFFORT=none
# Darmowy klucz Gemini z https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (opcjonalnie) model Gemini, domyślnie gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite
# (opcjonalnie) zamiast Gemini: płatne API Claude
# ANTHROPIC_API_KEY=
# Codzienne crony (vercel.json → /api/cron/qc i /api/cron/prices). Vercel wysyła ten sekret
# w nagłówku zapytania crona; bez niego (albo krótszego niż 16 znaków) crony nic nie robią. Długi losowy ciąg.
# CRON_SECRET=
# (opcjonalnie) limity wyszukiwań: na osobę na godzinę i na całą stronę na dzień
# IMAGE_SEARCH_HOURLY_LIMIT=20
# IMAGE_SEARCH_DAILY_LIMIT=500

# (opcjonalnie) emoji z logo obok „xayezreps” w podglądzie linku na Discordzie, w formacie <:nazwa:id>
# DISCORD_LOGO_EMOJI=
